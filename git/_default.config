[alias]
	# Identity, shows current Author and Committer
	id = "!echo -n '   Author: '; git var GIT_AUTHOR_IDENT; echo -n 'Committer: '; git var GIT_COMMITTER_IDENT"

	# Config locations
	config-sys  = config --system
	config-user = config --global
	config-repo = config --local
	config-tree = config --worktree

	# Path locations (cd-ing needs shell aliases)
	repo-dir = rev-parse --git-common-dir
	git-dir  = rev-parse --git-dir
	tree-dir = rev-parse --show-toplevel

	# Listings
	alternates = !git rev-parse --git-dir > /dev/null && declare a="`git rev-parse --git-path objects/info/alternates`" && test -f "${a}" && cat "${a}"
	commands   = help --all
	configs    = help --config
	branches   = branch -vva
	remotes    = remote -v
	tags       = !git show --no-patch `git tag --list --sort=-creatordate`
	trees      = worktree list

	# git blame temporal coloring; see color.blame
	chrono             = blame --color-by-age
	chrono-line-days   = -c 'color.blame.highlightRecent="brightblack,12   days ago,red,10   days ago,yellow, 8   days ago,green, 6   days ago,cyan, 4   days ago,blue, 2   days ago,magenta"' blame --color-by-age
	chrono-line-weeks  = -c 'color.blame.highlightRecent="brightblack,12  weeks ago,red,10  weeks ago,yellow, 8  weeks ago,green, 6  weeks ago,cyan, 4  weeks ago,blue, 2  weeks ago,magenta"' blame --color-by-age
	chrono-line-months = -c 'color.blame.highlightRecent="brightblack,12 months ago,red,10 months ago,yellow, 8 months ago,green, 6 months ago,cyan, 4 months ago,blue, 2 months ago,magenta"' blame --color-by-age
	chrono-line-years  = -c 'color.blame.highlightRecent="brightblack,12  years ago,red,10  years ago,yellow, 8  years ago,green, 6  years ago,cyan, 4  years ago,blue, 2  years ago,magenta"' blame --color-by-age
	chrono-quad-days   = -c 'color.blame.highlightRecent="brightblack,25   days ago,red,16   days ago,yellow, 9   days ago,green, 4   days ago,cyan, 2   days ago,blue,12  hours ago,magenta"' blame --color-by-age
	chrono-quad-weeks  = -c 'color.blame.highlightRecent="brightblack,16  weeks ago,red, 9  weeks ago,yellow, 4  weeks ago,green, 2  weeks ago,cyan, 1  week  ago,blue,42  hours ago,magenta"' blame --color-by-age
	chrono-quad-months = -c 'color.blame.highlightRecent="brightblack,16 months ago,red, 9 months ago,yellow, 4 months ago,green, 2 months ago,cyan, 1 month  ago,blue, 1  week  ago,magenta"' blame --color-by-age
	chrono-quad-years  = -c 'color.blame.highlightRecent="brightblack,16  years ago,red, 9  years ago,yellow, 4  years ago,green, 2  years ago,cyan, 1  year  ago,blue, 3 months ago,magenta"' blame --color-by-age

	# GUI interactive commit staging
	citool-dense            = -c gui.diffContext=1 citool
	citool-dense-myers      = -c gui.diffContext=1 -c diff.algorithm=myers     citool
	citool-dense-minimal    = -c gui.diffContext=1 -c diff.algorithm=minimal   citool
	citool-dense-patience   = -c gui.diffContext=1 -c diff.algorithm=patience  citool
	citool-dense-histogram  = -c gui.diffContext=1 -c diff.algorithm=histogram citool
	citool-sparse           = -c gui.diffContext=5 citool
	citool-sparse-myers     = -c gui.diffContext=5 -c diff.algorithm=myers     citool
	citool-sparse-minimal   = -c gui.diffContext=5 -c diff.algorithm=minimal   citool
	citool-sparse-patience  = -c gui.diffContext=5 -c diff.algorithm=patience  citool
	citool-sparse-histogram = -c gui.diffContext=5 -c diff.algorithm=histogram citool

	# Diffs
	diff-myers            = diff --diff-algorithm=myers
	diff-minimal          = diff --diff-algorithm=minimal
	diff-patience         = diff --diff-algorithm=patience
	diff-histogram        = diff --diff-algorithm=histogram
	diff-cached           = diff --cached
	diff-cached-myers     = diff --cached --diff-algorithm=myers
	diff-cached-minimal   = diff --cached --diff-algorithm=minimal
	diff-cached-patience  = diff --cached --diff-algorithm=patience
	diff-cached-histogram = diff --cached --diff-algorithm=histogram
	diff-merge            = diff --merge-base HEAD
	diff-merge-myers      = diff --merge-base HEAD --diff-algorithm=myers
	diff-merge-minimal    = diff --merge-base HEAD --diff-algorithm=minimal
	diff-merge-patience   = diff --merge-base HEAD --diff-algorithm=patience
	diff-merge-histogram  = diff --merge-base HEAD --diff-algorithm=histogram
	diff-staged           = diff --staged
	diff-staged-myers     = diff --staged --diff-algorithm=myers
	diff-staged-minimal   = diff --staged --diff-algorithm=minimal
	diff-staged-patience  = diff --staged --diff-algorithm=patience
	diff-staged-histogram = diff --staged --diff-algorithm=histogram

	# Diff statistics
	diffchart        = diff --stat --stat-name-width=30
	diffchart-cached = diff --stat --stat-name-width=30 --cached
	diffchart-merge  = diff --stat --stat-name-width=30 --merge-base HEAD
	diffchart-staged = diff --stat --stat-name-width=30 --staged
	diffstat         = diff --stat
	diffstat-cached  = diff --stat --cached
	diffstat-merge   = diff --stat --merge-base HEAD
	diffstat-staged  = diff --stat --staged
	diffname         = diff --name-status
	diffname-cached  = diff --name-status --cached
	diffname-merge   = diff --name-status --merge-base HEAD
	diffname-staged  = diff --name-status --staged
	dirstat          = diff --dirstat
	dirstat-cached   = diff --dirstat --cached
	dirstat-merge    = diff --dirstat --merge-base HEAD
	dirstat-staged   = diff --dirstat --staged
	linestat         = diff --shortstat
	linestat-cached  = diff --shortstat --cached
	linestat-merge   = diff --shortstat --merge-base HEAD
	linestat-staged  = diff --shortstat --staged

	# GUI tools
	diffgui  = difftool --gui
	mergegui = mergetool --gui

	# Logs and Graphs
	graph      = log --graph
	graph-1d   = log --graph --since='1 day ago'
	graph-1w   = log --graph --since='1 week ago'
	graph-1m   = log --graph --since='1 month ago'
	graph-1y   = log --graph --since='1 year ago'
	graph-deco = log --graph --simplify-by-decoration
	graph-topo = log --graph --topo-order
	graph-auth = log --graph --author-date-order
	graph-date = log --graph --date-order
	graphchart = log --graph --pretty=hone --stat --stat-name-width=30
	graphname  = log --graph --pretty=hone --name-status
	graphstat  = log --graph --pretty=hone --stat
	graphstatd = log --graph --pretty=hone --dirstat
	graphstatl = log --graph --pretty=hone --shortstat
	log-1d     = log --since='1 day ago'
	log-1w     = log --since='1 week ago'
	log-1m     = log --since='1 month ago'
	log-1y     = log --since='1 year ago'
	log-deco   = log --simplify-by-decoration
	log-auth   = log --author-date-order
	log-date   = log --date-order
	logchart   = log --pretty=hone --stat --stat-name-width=30
	logdiff    = log --pretty=hone --patch
	logname    = log --pretty=hone --name-status
	logstat    = log --pretty=hone --stat
	logstatd   = log --pretty=hone --dirstat
	logstatl   = log --pretty=hone --shortstat
	rlog       = reflog
	rlogdiff   = reflog --pretty=hone --patch
	rlogname   = reflog --pretty=hone --name-status
	rlogstat   = reflog --pretty=hone --stat
	rlogstatd  = reflog --pretty=hone --dirstat
	rlogstatl  = reflog --pretty=hone --shortstat

	# Timelines
	decoline      = log --graph --all --date-order --simplify-by-decoration
	headline      = log --graph --all --date-order --simplify-by-decoration --decorate-refs=refs/heads
	localline     = log --graph --all --date-order --simplify-by-decoration --decorate-refs=refs/heads,refs/tags
	nameline      = log --graph --all --date-order --simplify-by-decoration --decorate-refs=refs/heads,refs/remotes
	tagline       = log --graph --all --date-order --simplify-by-decoration --decorate-refs=refs/tags
	timeline      = log --graph --all --date-order
	timeline-1d   = log --graph --all --date-order --since='1 day ago'
	timeline-1w   = log --graph --all --date-order --since='1 week ago'
	timeline-1m   = log --graph --all --date-order --since='1 month ago'
	timeline-1y   = log --graph --all --date-order --since='1 year ago'
	timelinechart = log --graph --all --date-order --pretty=hone --stat --stat-name-width=30
	timelinename  = log --graph --all --date-order --pretty=hone --name-status
	timelinestat  = log --graph --all --date-order --pretty=hone --stat

	# Calendars, Histograms and Counts
	calendar-copyright  = shortlog -s --no-merges --group='%cd  %cN  <%cE>' --date='format-local:%Y'
	calendar-day        = shortlog -s --no-merges --group='%cd' --date='format-local:%Y-%m-%d  %A'
	calendar-week       = shortlog -s --no-merges --group='%cd' --date='format-local:%Y, week %V'
	calendar-month      = shortlog -s --no-merges --group='%cd' --date='format-local:%Y-%m  %B'
	calendar-year       = shortlog -s --no-merges --group='%cd' --date='format-local:%Y'
	count               = rev-list --count
	histogram-author    = shortlog -s --no-merges --group='%aN  <%aE>'
	histogram-committer = shortlog -s --no-merges --group='%cN  <%cE>'
	histogram-hour      = shortlog -s --no-merges --group='%cd' --date='format-local:%H'
	histogram-month     = shortlog -s --no-merges --group='%cd' --date='format-local:%m  %B'
	histogram-week      = shortlog -s --no-merges --group='%cd' --date='format-local:week %V'
	histogram-weekday   = shortlog -s --no-merges --group='%cd' --date='format-local:%u  %A'

	# Commits, Merges, Pulls and Pushes
	commit-blank = commit --allow-empty-message --no-edit
	commit-init  = commit --message='Initial commit'
	fetch-dry    = fetch --dry-run
	merge-ff     = merge --ff-only
	merge-stage  = merge --no-commit
	pull-dry     = pull --dry-run
	pull-ff      = pull --ff-only
	pull-stage   = pull --no-commit
	push-dry     = push --dry-run

	# Statuses
	stats      = status --short
	stats-all  = status --short --untracked-files=all
	stats-mod  = status --short --untracked-files=no
	state      = -c status.relativePaths=false status --short
	state-all  = -c status.relativePaths=false status --short --untracked-files=all
	state-mod  = -c status.relativePaths=false status --short --untracked-files=no
	status-all = status --untracked-files=all
	status-mod = status --untracked-files=no

	# Worktrees
	tree       = worktree

[blame]
	date = human-local

[color]
	ui = auto

[color "advice"]
	hint = brightblue

[color "blame"]
	# Default
	highlightRecent = "brightblack, 5  years ago,red, 1  year  ago,yellow, 3 months ago,green, 1 month  ago,cyan, 1  week  ago,blue, 1   day  ago,magenta"

	# Linear - Days
#	highlightRecent = "brightblack,12   days ago,red,10   days ago,yellow, 8   days ago,green, 6   days ago,cyan, 4   days ago,blue, 2   days ago,magenta"

	# Linear - Weeks
#	highlightRecent = "brightblack,12  weeks ago,red,10  weeks ago,yellow, 8  weeks ago,green, 6  weeks ago,cyan, 4  weeks ago,blue, 2  weeks ago,magenta"

	# Linear - Months
#	highlightRecent = "brightblack,12 months ago,red,10 months ago,yellow, 8 months ago,green, 6 months ago,cyan, 4 months ago,blue, 2 months ago,magenta"

	# Linear - Years
#	highlightRecent = "brightblack,12  years ago,red,10  years ago,yellow, 8  years ago,green, 6  years ago,cyan, 4  years ago,blue, 2  years ago,magenta"

	# Quadratic - Days
#	highlightRecent = "brightblack,25   days ago,red,16   days ago,yellow, 9   days ago,green, 4   days ago,cyan, 2   days ago,blue,12  hours ago,magenta"

	# Quadratic - Weeks
#	highlightRecent = "brightblack,16  weeks ago,red, 9  weeks ago,yellow, 4  weeks ago,green, 2  weeks ago,cyan, 1  week  ago,blue,42  hours ago,magenta"

	# Quadratic - Months
#	highlightRecent = "brightblack,16 months ago,red, 9 months ago,yellow, 4 months ago,green, 2 months ago,cyan, 1 month  ago,blue, 1  week  ago,magenta"

	# Quadratic - Years
#	highlightRecent = "brightblack,16  years ago,red, 9  years ago,yellow, 4  years ago,green, 2  years ago,cyan, 1  year  ago,blue, 3 months ago,magenta"

	repeatedLines   = brightblack

[color "branch"]
	current  = bold brightgreen
	local    = green
	plain    = yellow
	remote   = red
	# NOTE: `reset` is undocumented
	# Highlights active branch when `current` has `bold`
	reset    = default
	upstream = red

[color "decorate"]
	HEAD         = magenta
	branch       = green
	grafted      = blue
	remoteBranch = red
	stash        = brightmagenta
	tag          = cyan

[color "diff"]
	frag                = brightyellow
	oldMoved            = normal magenta
	newMoved            = normal cyan
	oldMovedAlternative = normal magenta
	newMovedAlternative = normal cyan
	whitespace          = normal yellow

[color "status"]
#	header       = # leave default
	added        = green
	changed      = yellow
	untracked    = red
	branch       = bold brightgreen
	nobranch     = bold brightblue
	localBranch  = green
	remoteBranch = red
#	unmerged     =

[column]
	ui = auto

[completion]
	commands = -am -apply -cherry count-objects -format-patch -gitk -gui -instaweb ls-files ls-remote -new-workdir -reflog -send-email symbolic-ref var -whatchanged -worktree

[diff]
	algorithm        = patience
	colorMoved       = zebra
	context          = 3
	interHunkContext = 10
	mnemonicPrefix   = true

[format]
	pretty = one

[gui]
	diffContext = 3
	tabsize = 4
	commitmsgwidth = 120

[init]
	defaultBranch = core

[log]
	date = human-local

[pager]
	blame    = LESS=\"${LESS} -S\"  \"$(git var GIT_PAGER)\"
	branch   = LESS=\"${LESS} -F\"  \"$(git var GIT_PAGER)\"
	config   = LESS=\"${LESS} -S\"  \"$(git var GIT_PAGER)\"
	diff     = LESS=\"${LESS} -S\"  \"$(git var GIT_PAGER)\"
	help     = LESS=\"${LESS} -F\"  \"$(git var GIT_PAGER)\"
	log      = LESS=\"${LESS} -FS\" \"$(git var GIT_PAGER)\"
	reflog   = LESS=\"${LESS} -FS\" \"$(git var GIT_PAGER)\"
	shortlog = LESS=\"${LESS} -F\"  \"$(git var GIT_PAGER)\"
	show     = LESS=\"${LESS} -S\"  \"$(git var GIT_PAGER)\"
	status   = LESS=\"${LESS} -F\"  \"$(git var GIT_PAGER)\"
	tag      = LESS=\"${LESS} -F\"  \"$(git var GIT_PAGER)\"

[pretty]
	# Full references only
	references   =            "tformat:%C(auto)%H  %D"
	refs         =            "tformat:%C(auto)%h  %D"

	# Short references with dates, truncated
	refs-date    =            "tformat:%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %D"
	refs-adate   =            "tformat:%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %D"
	refs-cdate   =            "tformat:%C(auto)%h  %C(brightyellow)%<(12,trunc)%cd%C(auto)  %D"

	# Dates only, truncated
	date         =                        "tformat:%C(brightyellow)%<(12,trunc)%ad%C(auto)  %D"
	adate        =                        "tformat:%C(brightyellow)%<(12,trunc)%ad%C(auto)  %D"
	cdate        =                        "tformat:%C(brightyellow)%<(12,trunc)%cd%C(auto)  %D"

	# Full commit message
	msg      =            "%C(auto)%B"
	msg-80   =  "%w(80,0,0)%C(auto)%B"
	msg-100  = "%w(100,0,0)%C(auto)%B"
	msg-120  = "%w(120,0,0)%C(auto)%B"
	msg-140  = "%w(140,0,0)%C(auto)%B"
	msg-160  = "%w(160,0,0)%C(auto)%B"

	# Full commit message, collapsed
	msgc     =            "%C(auto,bold)%s%C(auto)%n%n%-b"
	msgc-80  =  "%w(80,0,0)%C(auto,bold)%s%C(auto)%n%n%-b"
	msgc-100 = "%w(100,0,0)%C(auto,bold)%s%C(auto)%n%n%-b"
	msgc-120 = "%w(120,0,0)%C(auto,bold)%s%C(auto)%n%n%-b"
	msgc-140 = "%w(140,0,0)%C(auto,bold)%s%C(auto)%n%n%-b"
	msgc-160 = "%w(160,0,0)%C(auto,bold)%s%C(auto)%n%n%-b"

	#
	# Line-limited formats
	#
	# Dates are truncated!
	#
	# Formats ending in:
	# -<number>  -- number determines output width, wordwraps overflow
	# -<number>t -- number determines output width, truncates overflow, proportionally
	#

	# One line (short ref, author date, message subject, decorations)
	one          =            "tformat:%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-80       =  "tformat:%w(80,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-100      = "tformat:%w(100,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-120      = "tformat:%w(120,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-140      = "tformat:%w(140,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-160      = "tformat:%w(160,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"

	# One line, ref only (short ref, message subject, decorations)
	one-ref      =            "tformat:%C(auto)%h  %s  %D"
	one-ref-80   =  "tformat:%w(80,0,4)%C(auto)%h  %s  %D"
	one-ref-100  = "tformat:%w(100,0,4)%C(auto)%h  %s  %D"
	one-ref-120  = "tformat:%w(120,0,4)%C(auto)%h  %s  %D"
	one-ref-140  = "tformat:%w(140,0,4)%C(auto)%h  %s  %D"
	one-ref-160  = "tformat:%w(160,0,4)%C(auto)%h  %s  %D"

	# One line, date only (author date, message subject, decorations)
	one-date     =                        "tformat:%C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-date-80  =              "tformat:%w(80,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-date-100 =             "tformat:%w(100,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-date-120 =             "tformat:%w(120,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-date-140 =             "tformat:%w(140,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"
	one-date-160 =             "tformat:%w(160,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %s  %D"

	# One line - date, author, message (author date, author, message subject, decorations)
	one-dam      =                        "tformat:%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %s  %D"
	one-dam-80   =              "tformat:%w(80,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %s  %D"
	one-dam-100  =             "tformat:%w(100,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %s  %D"
	one-dam-120  =             "tformat:%w(120,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %s  %D"
	one-dam-140  =             "tformat:%w(140,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %s  %D"
	one-dam-160  =             "tformat:%w(160,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %s  %D"

	# One line (short ref, author date, message subject, decorations), highlight
	hone     =            "tformat:%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(auto)  %s  %D"
	hone-80  =  "tformat:%w(80,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(auto)  %s  %D"
	hone-100 = "tformat:%w(100,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(auto)  %s  %D"
	hone-120 = "tformat:%w(120,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(auto)  %s  %D"
	hone-140 = "tformat:%w(140,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(auto)  %s  %D"
	hone-160 = "tformat:%w(160,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(auto)  %s  %D"

	# Two lines
	two         =             "tformat:%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%n%s"
	two-80      =   "tformat:%w(80,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(80,0,0)%s"
	two-100     =  "tformat:%w(100,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(100,0,0)%s"
	two-120     =  "tformat:%w(120,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(120,0,0)%s"
	two-140     =  "tformat:%w(140,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(140,0,0)%s"
	two-160     =  "tformat:%w(160,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(160,0,0)%s"

	# Two lines, with full commit message
	two-msg     =             "tformat:%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%n%B"
	two-msg-80  =   "tformat:%w(80,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(80,0,0)%B"
	two-msg-100 =  "tformat:%w(100,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(100,0,0)%B"
	two-msg-120 =  "tformat:%w(120,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(120,0,0)%B"
	two-msg-140 =  "tformat:%w(140,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(140,0,0)%B"
	two-msg-160 =  "tformat:%w(160,0,4)%C(auto)%h  %C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %D%w(0)%n%w(160,0,0)%B"

	# Two lines, highlight
	htwo     =            "tformat:%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(black blue) %aN %C(auto) %D%n%s"
	htwo-80  =  "tformat:%w(80,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(black blue) %aN %C(auto) %D%w(0)%n%w(80,0,0)%s"
	htwo-100 = "tformat:%w(100,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(black blue) %aN %C(auto) %D%w(0)%n%w(100,0,0)%s"
	htwo-120 = "tformat:%w(120,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(black blue) %aN %C(auto) %D%w(0)%n%w(120,0,0)%s"
	htwo-140 = "tformat:%w(140,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(black blue) %aN %C(auto) %D%w(0)%n%w(140,0,0)%s"
	htwo-160 = "tformat:%w(160,0,0)%C(black yellow) %h %C(black brightyellow)%<(12,trunc) %ad %C(black blue) %aN %C(auto) %D%w(0)%n%w(160,0,0)%s"

	# Three lines
	three     = "tformat:\
%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%n\
%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%n\
%C(auto)%s\
"
	three-80  = "tformat:\
%w(80,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(80,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(80,0,0)%C(auto)%s\
"
	three-100 = "tformat:\
%w(100,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(100,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(100,0,0)%C(auto)%s\
"
	three-120 = "tformat:\
%w(120,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(120,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(120,0,0)%C(auto)%s\
"
	three-140 = "tformat:\
%w(140,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(140,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(140,0,0)%C(auto)%s\
"
	three-160 = "tformat:\
%w(160,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(160,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(160,0,0)%C(auto)%s\
"

	# Three lines, with full commit message
	three-msg     = "tformat:\
%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%n\
%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%n\
%C(auto)%B\
"
	three-msg-80  = "tformat:\
%w(80,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(80,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(80,0,0)%C(auto)%B\
"
	three-msg-100 = "tformat:\
%w(100,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(100,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(100,0,0)%C(auto)%B\
"
	three-msg-120 = "tformat:\
%w(120,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(120,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(120,0,0)%C(auto)%B\
"
	three-msg-140 = "tformat:\
%w(140,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(140,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(140,0,0)%C(auto)%B\
"
	three-msg-160 = "tformat:\
%w(160,0,4)%C(brightyellow)%<(12,trunc)%ad%C(auto)  %C(brightblue)%aN%C(auto)  %C(auto)%h  %D%w(0)%n\
%w(160,0,4)%C(brightyellow)%<(12,trunc)%cd%C(auto)  %C(brightwhite)%cN%C(auto)  %G?%w(0)%n\
%w(160,0,0)%C(auto)%B\
"

	# Long, or detailed
	long  = "tformat:\
%C(brightblack)    Commit %C(auto) %H  %C(brightblack) Sig %C(auto) %G?%n\
%-(decorate:prefix=      Refs  ,suffix=,tag=)%n\
%C(brightblack)    Author %C(auto) %<(16,trunc)%C(brightyellow)%ad%C(auto)  %C(brightwhite)%aN%C(auto) <%C(brightblue)%aE%C(auto)>%n\
%C(brightblack) Committer %C(auto) %<(16,trunc)%C(brightyellow)%cd%C(auto)  %C(brightwhite)%cN%C(auto) <%C(brightblue)%cE%C(auto)>%n\
%C(brightblack)   Subject %C(auto) %s%n\
"

	# Long, or detailed, highlight
	hlong = "tformat:\
%C(reverse red)    Commit %C(auto) %H  %C(reverse red) Sig %C(auto) %G?%n\
%-(decorate:prefix=      Refs  ,suffix=,tag=)%n\
%C(reverse red)    Author %C(auto) %<(16,trunc)%C(brightyellow)%ad%C(auto)  %C(brightwhite)%aN%C(auto) <%C(brightblue)%aE%C(auto)>%n\
%C(reverse red) Committer %C(auto) %<(16,trunc)%C(brightyellow)%cd%C(auto)  %C(brightwhite)%cN%C(auto) <%C(brightblue)%cE%C(auto)>%n\
%C(reverse red)   Subject %C(auto) %s%n\
"

	# Long, or detailed, with full commit message
	all   = "tformat:\
%C(brightblack)    Commit %C(auto) %H  %C(brightblack) Sig %C(auto) %G?%n\
%-(decorate:prefix=      Refs  ,suffix=,tag=)%n\
%C(brightblack)    Author %C(auto) %<(16,trunc)%C(brightyellow)%ad%C(auto)  %C(brightwhite)%aN%C(auto) <%C(brightblue)%aE%C(auto)>%n\
%C(brightblack) Committer %C(auto) %<(16,trunc)%C(brightyellow)%cd%C(auto)  %C(brightwhite)%cN%C(auto) <%C(brightblue)%cE%C(auto)>%n\
%w(0,0,4)%C(brightblack)   Subject %C(auto) %B\
"

	# Long, or detailed, with full commit message, highlight
	hall  = "tformat:\
%C(reverse red)    Commit %C(auto) %H  %C(reverse red) Sig %C(auto) %G?%n\
%-(decorate:prefix=      Refs  ,suffix=,tag=)%n\
%C(reverse red)    Author %C(auto) %<(16)%C(brightyellow)%ad%C(auto)  %C(brightwhite)%aN%C(auto) <%C(brightblue)%aE%C(auto)>%n\
%C(reverse red) Committer %C(auto) %<(16)%C(brightyellow)%cd%C(auto)  %C(brightwhite)%cN%C(auto) <%C(brightblue)%cE%C(auto)>%n\
%w(0,0,4)%C(reverse red)   Subject %C(auto) %B\
"

[user]
	useConfigOnly = true

#
# Includes
#

[include]
	path = __user.config

#
# Conditional Includes
#

[includeIf "gitdir:github.com/"]
	path = __host/github.com.config

[includeIf "gitdir:gist.github.com/"]
	path = __host/github.com.config

[includeIf "gitdir:gitlab.com/"]
	path = __host/gitlab.com.config
