kate-wildcard(*.atom): syntax XML;
kate-wildcard(*.json): indent-width 2; tab-width 2;
kate-wildcard(*.jsonc): syntax JSON; indent-width 2; tab-width 2;
kate-wildcard(*.sublime-color-scheme): syntax YAML; indent-width 2; tab-width 2;
kate-wildcard(*.sublime-syntax): syntax YAML; indent-width 2; tab-width 2;
kate-wildcard(*.tmTheme): syntax XML;
kate-wildcard(*.yaml): indent-width 2; tab-width 2;
kate-wildcard(.clang-format): syntax YAML; indent-width 2; tab-width 2;
kate-wildcard(.npmrc): syntax INI Files;
kate-wildcard(.uncrustify.cfg): syntax INI Files;
kate-wildcard(HOME/bashrc.d/*): syntax Bash;
kate-wildcard(HOME/profile.d/*): syntax Bash;
kate-wildcard(XDG_CONFIG_HOME/git/*): syntax INI Files;
kate-wildcard(XDG_CONFIG_HOME/git/app/*): syntax INI Files;
kate-wildcard(XDG_CONFIG_HOME/git/host/*): syntax INI Files;
kate-wildcard(XDG_CONFIG_HOME/git/ignore): syntax Git Ignore;
kate-wildcard(XDG_CONFIG_HOME/osc/oscrc): syntax INI Files;
kate-wildcard(XDG_DATA_HOME/bash-completion/completions/*): syntax Bash;
kate-wildcard(XDG_DATA_HOME/konsole/*): syntax INI Files;
kate-wildcard(etc/mke2fs.conf): syntax TOML;
