# zypper bash completion script
#
# A hackweek gift from Marek Stopka <mstopka@opensuse.org>
# Major rewrite by Josef Reidinger <jreidinger@suse.cz>
# 2009-02-19 Allow empty spaces in repos names, Werner Fink <werner@suse.de>
# 2015-04-26 add completion for install+remove+update commands, Bernhard M. Wiedemann <bwiedemann@suse.de>
# 2026-09-30 speed up invocation with herestrings, Boian Berberov

_strip() {
	local s c o
	if   (( 0 < ${#COMPREPLY[@]} ))
	then
		s="${COMP_WORDBREAKS// }"
		s="${s//	}"
		s="${s//[\{\}()\[\]]}"
		s="${s} 	(){}[]"
		o=${#s}
		while (( 0 < o-- ))
		do
			c="${s:${o}:1}"
			COMPREPLY=(${COMPREPLY[*]//${c}/\\${c}})
		done
	fi
}

_installed_packages() {
	! [[ $cur =~ / ]] || return
	command grep --no-messages --no-filename "^$cur"  \
		'/var/cache/zypp/solv/@System/solv.idx' \
		| cut -f1 \
		| sort --unique
}

_available_solvables2() {
	local lcur=$1
	! [[ $cur =~ / ]] || return # for installing local packages
	set +o noglob
	command grep --no-messages --no-filename "^$lcur" \
		/var/cache/zypp/solv/*/solv.idx \
		| cut -f1 \
		| sort --unique
	set -o noglob
}
_available_solvables() {
	_available_solvables2 "$1:$cur" | sed -e "s/^$1://"
}
_available_packages() {
	[[ $cur ]] || return # this case is too slow with many thousands of completions
	_available_solvables2 $cur
}
_zypper_sed_table_filter='
	/^[[:blank:]]*[0-9]+[[:blank:]]*\|/{
		s/^[[:blank:]]*[0-9]+[[:blank:]]*\|[[:blank:]]*([^|]+).*/\1/
		s/[[:blank:]]*$//
		/^$/d
		p
	}
'

_repositories() {
	LC_ALL=POSIX "$(type -P zypper)" -q repos --alias --sort-by-alias \
	| sed -r -n -e "${_zypper_sed_table_filter}"
}

_zypper() {
	ZYPPER="$(type -P zypper)"

	local noglob=$(shopt -po noglob)
	local comp cur prev command
	local -a opts=()
	local -i ITER=0
	local IFS=$'\t\n'

	# Do not expand `?' for help
	set -o noglob

	local ZYPPER_HELP="$(LC_ALL=POSIX $ZYPPER -q -h)"

	local -a ZYPPER_CMDLIST=(
		$(sed -n -E -e '/^Commands:$/,${ /^ {6}/{ s/^ {6}//; s/ {2}.*$//; s/, /\t/g; p } }' <<<"${ZYPPER_HELP}" | sort --unique)
	)

	local -a ZYPPER_CMDLONG=(
		$(sed -n -E -e '/^Commands:$/,$s/^ {6}([^, ]+).*/\1/p' <<<"${ZYPPER_HELP}" | sort --unique)
	)

	local -a ZYPPER_OPTLIST=(
		$(sed -n -E -e '/^Global Options:$/,/^Commands:$/{ /^ {4}/{ s/^ {4}//; s/ {2}.*$//; s/, /\t/g; s/ .*$//; p; } }' <<<"${ZYPPER_HELP}" | sort --unique)
	)

	local -a ZYPPER_OPTLONG=(
		$(sed -n -E -e '/^Global Options:$/,/^Commands:$/s/^ {4}(--[^ ,]*).*/\1/p' <<<"${ZYPPER_HELP}" | sort --unique)
	)

	if   (( COMP_CWORD < 1 ))
	then
		let COMP_CWORD=${#COMP_WORDS[@]}
	fi
	prev=${COMP_WORDS[COMP_CWORD-1]}
	cur=${COMP_WORDS[COMP_CWORD]}

	ITER=$((COMP_CWORD))
	while (( 0 < ITER-- ))
	do
		comp="${COMP_WORDS[ITER]}"
		# bsc#1049826 - surrounding ' 's are important to get a word-match of ${comp}:
		if   [[ " ${ZYPPER_CMDLIST[@]} " =~ " ${comp} " ]]
		then
			command=${COMP_WORDS[ITER]}
			break;
		elif [[ 'zypper' == "${comp}" ]]
		then
			command='zypper'
			break;
		fi
	done

	case "$prev" in
		--type | -t )
			opts=(package patch pattern product srcpackage)
			COMPREPLY=($(compgen -W "${opts[*]}" -- ${cur}))
			_strip
			eval $noglob
			return 0;
		;;
		--repo | -r | --from )
			opts=($(_repositories))
			COMPREPLY=($(compgen -W "${opts[*]}" -- ${cur}))
			_strip
			eval $noglob
			return 0;
		;;
		--conflicts         |\
		--conflicts-pkg     |\
		--enhances          |\
		--enhances-pkg      |\
		--obsoletes         |\
		--obsoletes-pkg     |\
		--provides-pkg      |\
		--provides-pkg      |\
		--recommends        |\
		--recommends-pkg    |\
		--requires-pkg      |\
		--requires-pkg      |\
		--suggests          |\
		--suggests-pkg      |\
		--supplements       |\
		--supplements-pkg   )
			opts=($(_available_packages))
			COMPREPLY=($(compgen -W "${opts[*]}" -- ${cur}))
			_strip
			eval $noglob
			return 0;
		;;
	esac

	if   [[ 'zypper' == "${command}" ]]
	then
		opts=(${ZYPPER_OPTLONG[*]} ${ZYPPER_CMDLONG[*]})

		# ${opts} are already sorted and grouped
		compopt -o nosort
		COMPREPLY=($(compgen -W "${opts[*]}" -- ${cur}))
		_strip
		eval $noglob
		return 0;
	fi

	if   [[ -n "${command}" ]]
	then
		if   [[ -z $cur || $cur =~ ^- ]]
		then
			if   [[ "${command}" == "${command%-color}-color" ]]
			then
				opts=$(LC_ALL=POSIX $ZYPPER -q help ${command%-color} 2>&1 | sed -n '1,/[Oo]ptions:$/d; s/^.\{,6\}\(--[^[:blank:][]*\).*/\1/p')
			else
				opts=$(LC_ALL=POSIX $ZYPPER -q help ${command} 2>&1 | sed -n '1,/[Oo]ptions:$/d; s/^.\{,6\}\(--[^[:blank:][]*\).*/\1/p')
			fi
		fi

		#handling individual commands if they need more then we can dig from help
		if   [[ -z $cur || $cur =~ ^[^-] ]]
		then
			case "$command" in
				help | '?' )
					opts=(${ZYPPER_CMDLIST[@]})
				;;
				clean | cc | modifyrepo | mr | refresh | ref | removerepo | rr | renamerepo | nr | repos | lr )
					opts=(
						${opts[@]}
						$(_repositories)
					)
				;;
				addservice | as | modifyservice | ms | removeservice | rs | refresh-services | refs )
					opts=(
						${opts[@]}
						$(LC_ALL=POSIX $ZYPPER -q ls --sort-by-name | sed -rn -e "${_zypper_sed_table_filter}")
					)
				;;
				removelock | rl )
					opts=(
						${opts[@]}
						$(LC_ALL=POSIX $ZYPPER -q ll | sed -rn -e "${_zypper_sed_table_filter}")
					)
				;;
				product-info )
					opts=(
						${opts[@]}
						$(_available_solvables product)
					)
				;;
				pattern-info )
					opts=(
						${opts[@]}
						$(_available_solvables pattern)
					)
				;;
				patch-info )
					opts=(
						${opts[@]}
						$(_available_solvables patch)
					)
				;;
				remove | rm | update | up )
					opts=(
						${opts[@]}
						$(_installed_packages)
					)
				;;
				install | in | source-install | si | download | info | if | addlock | al )
					opts=(
						${opts[@]}
						$(_available_packages)
					)
				;;
				info-color )
					opts=(
						${opts[@]}
						$(_available_packages)
					)
				;;
			esac
		fi

		# ${opts} are already sorted and grouped
		compopt -o nosort
		COMPREPLY=($(compgen -W "${opts[*]}" -- ${cur}))
		_strip
	fi
	eval $noglob
}

complete -F _zypper -o default zypper
