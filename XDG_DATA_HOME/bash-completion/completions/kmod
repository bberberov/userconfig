_comp_cmd_modinfo()
{
	# shellcheck disable=SC2034
	local cur prev words cword comp_args
	_comp_initialize -n = -- "$@" || return

	local short_opts='
		-V
		-F
		-b
		-k
		-0
		-h
	'
	local long_opts='
		--version
		--field=
		--basedir=
		--null
		--help
	'
	local fields='
		alias
		author
		depends
		description
		filename
		firmware
		import_ns
		intree
		license
		name
		parm
		retpoline
		sig_hashalgo
		sig_id
		sig_key
		signature
		signer
		srcversion
		suserelease
		vermagic
	'

	case "${prev}" in
		-F)
			_comp_compgen -c "${cur#*=}" -- -W "${fields}"
			return
		;;
		-b)
			return
		;;
		-k)
			_comp_compgen -c "${cur#*=}" -- -W "$(command ls -1 /lib/modules/)"
			return
		;;
		-V | --version | -h | --help)
			return
		;;
	esac

	case "${cur}" in
		--field=*)
			_comp_compgen -c "${cur#*=}" -- -W "${fields}"
			return
		;;
		--basedir=*)
			return
		;;
		--*)
			_comp_compgen -- -W "${long_opts}"
			[[ ${COMPREPLY-} == *= ]] && compopt -o nospace
			return
		;;
		-*)
			_comp_compgen -- -W "${short_opts} ${long_opts}"
			return
		;;
		*)
			# TODO list modules when -k or -b is set
			_comp_fn_modules "$(uname -r)"
			return
		;;
	esac
} && complete -F _comp_cmd_modinfo modinfo

