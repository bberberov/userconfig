_comp_fn_modules()
{
	# NOTE: hyperfine --warmup 1 "sed -e 's@^.*/@@; s/\.ko$//' /lib/modules/$(uname -r)/modules.order"
	# NOTE: hyperfine --warmup 1 "ls -1LR /lib/modules/$(uname -r)/ 2>/dev/null | sed -n -E -e 's/\.k?o(\.([gx]z|bz2|zst))?$//p'"

	local module_file="/lib/modules/${1}/modules.order"
	if   [[ -f "${module_file}" ]]
	then
		_comp_compgen -- -W "$(command sed -e 's@^.*/@@; s/\.ko$//' "${module_file}")"
	fi
	return
}

_comp_cmd_depmod()
{
	# shellcheck disable=SC2034
	local cur prev words cword comp_args
	_comp_initialize -- "$@" || return

	local short_opts='
		-h
		-v
		-V
	'
	local long_opts='
		--help
		--verbose
		--version
	'

	case "${prev}" in
		-V | --version | -h | --help)
			return
		;;
	esac

	case "${cur}" in
		--*)
			_comp_compgen -- -W "${long_opts}"
			return
		;;
		-*)
			_comp_compgen -- -W "${short_opts} ${long_opts}"
			return
		;;
		*)
			_comp_compgen_filedir
			return
		;;
	esac
} && complete -F _comp_cmd_depmod depmod

