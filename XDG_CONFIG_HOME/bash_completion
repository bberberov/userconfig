then
	complete -W '
		--git
		--timesort
		--sizesort
		--extensionsort
		--reverse
	' -o bashdefault -o default -o filenames \
		lsda \
		\
		lsdl \
		lsdlrs \
		lsdlrt \
		lsdlx \
		lsdla \
		lsdlars \
		lsdlart \
		lsdlax \
		\
		lsd-color \
		lsda-color \
		\
		lsdl-color \
		lsdlrs-color \
		lsdlrt-color \
		lsdlx-color \
		lsdla-color \
		lsdlars-color \
		lsdlart-color \
		lsdlax-color

	complete -W '
		--git
	' -o bashdefault -o default -o filenames \
		lsdt \
		lsdat \
		lsdlt \
		lsdlat \
		\
		lsdt-color \
		lsdat-color \
		lsdlt-color \
		lsdlat-color

	for (( i=2; i < 9; i+=1 ))
	do
		complete -W '
			--git
		' -o bashdefault -o default -o filenames \
			"lsdt${i}" \
			"lsdat${i}" \
			"lsdlt${i}" \
			"lsdlat${i}" \
			\
