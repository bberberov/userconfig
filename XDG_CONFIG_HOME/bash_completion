	complete -W '
		--all
		--almost-all
		--block-size=1
		--block-size=1G
		--block-size=1K
		--block-size=1M
		--group-directories-first
		--reverse
		--sort=extension
		--sort=size
		--sort=time
	' -o bashdefault -o default -o filenames \
		ll \
		lla \
		ll-color \
		lla-color

	complete -W '
		--block-size=1
		--block-size=1K
		--block-size=1M
		--block-size=1G
	' -o bashdefault -o default -o filenames \
		llrs \
		llrt \
		llg \
		llrsg \
		llrtg \
		llx \
		\
		llars \
		llart \
		llag \
		llarsg \
		llartg \
		llax \
		\
		llrs-color \
		llrt-color \
		llg-color \
		llrsg-color \
		llrtg-color \
		llx-color \
		\
		llars-color \
		llart-color \
		llag-color \
		llarsg-color \
		llartg-color \
		llax-color
fi

