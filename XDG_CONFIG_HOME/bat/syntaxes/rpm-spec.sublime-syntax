%YAML 1.2
---
name: "RPM Spec"
file_extensions: [ spec ]
scope: source.rpm.spec

variables:
  macro_ident: '[a-zA-Z0-9_]+'
  macro_param: '[*0-9]'
  macro_define: 'define|global'
  macro_cond: 'if|else|endif'
  macro_cond_op: '==|<=|>=|<|>|&&|\|\||!'
  macro_fn: "\
    bconf_with\
    |bconf_without\
  "

  spec_section: "\
    package\
    |description\
    \
    |prep\
    |build\
    |check\
    |install\
    |clean\
    |post\
    |postun\
    |files\
    |changelog\
    "

  tags: "\
    Name\
    |Version\
    |Release\
    |Group\
    |Summary\
    |License\
    |URL\
    \
    |Distribution\
    |Icon\
    |Vendor\
    |Packager\
    \
    |Source[0-9]+\
    |Patch[0-9]+\
    \
    |BuildRequires\
    |Requires(\\((pre|preun|post|postun)\\))?\
    \
    |Recommends\
    |Provides\
    |Supplements\
    |Suggests\
    |Enhances\
    |Conflicts\
    |Obsoletes\
    \
    |BuildRoot\
    |Prefix\
    "
  tags_arch: "\
    BuildArch\
    |ExcludeArch\
    |ExclusiveArch\
    "
  tags_obsolete: "\
    Epoch
    "
  tag_op: '>='

# sed -n -e '/arch_canon:/{ s/arch_canon:[^:]*:[[:space:]]*/\|/; s/[[:space:]]*[0-9]*$/\\/; p }' /usr/lib/rpm/rpmrc | uniq
  arches: "\
    |athlon\
    |geode\
    |pentium4\
    |pentium3\
    |i686\
    |i586\
    |i486\
    |i386\
    |x86_64\
    |x86_64_v2\
    |x86_64_v3\
    |x86_64_v4\
    |amd64\
    |ia32e\
    |em64t\
    |alpha\
    |alphaev5\
    |alphaev56\
    |alphapca56\
    |alphaev6\
    |alphaev67\
    |sparc64\
    |sparc64v\
    |sparc\
    |sparcv8\
    |sparcv9\
    |sparcv9v\
    |mips\
    |mipsel\
    |ppc\
    |ppc8260\
    |ppc8560\
    |ppc32dy4\
    |ppciseries\
    |ppcpseries\
    |m68k\
    |sgi\
    |rs6000\
    |ia64\
    |mips64\
    |mips64el\
    |armv3l\
    |armv4b\
    |armv4l\
    |armv5tl\
    |armv5tel\
    |armv5tejl\
    |armv6l\
    |armv6hl\
    |armv7l\
    |armv7hl\
    |armv7hnl\
    |armv8l\
    |armv8hl\
    |m68kmint\
    |s390\
    |i370\
    |s390x\
    |ppc64\
    |ppc64le\
    |ppc64pseries\
    |ppc64iseries\
    |ppc64p7\
    |sh\
    |sh3\
    |sh4\
    |sh4a\
    |xtensa\
    |aarch64\
    |mipsr6\
    |mipsr6el\
    |mips64r6\
    |mips64r6el\
    |riscv64\
    |loongarch64\
    "

contexts:
  main:
    - match: '#'
      push: comment
    - match: '%%'
      scope: constant.character.escape.spec
    - match: '%({{macro_cond}})\b'
      scope: keyword.control.conditional.spec
      push: macro_conditional
    - match: '%({{macro_define}})\b'
      scope: keyword.control.spec
      push: macro_define
    - match: '%({{macro_param}})\b'
      scope: variable.other.spec
    - match: '%\{({{macro_param}})\}\b'
      scope: variable.other.spec
    - match: '%({{spec_section}})\b'
      scope: entity.name.function.spec
    - match: '%'
      scope: keyword.operator.spec
      push: macro_generic
    - match: '^({{tags}}):'
      scope: entity.name.tag.spec
    - match: '^({{tags_arch}}):'
      scope: entity.name.tag.spec
    - match: '^({{tags_obsolete}}):'
      scope: invalid.deprecated.spec
    # - include: scope:source.shell

  comment:
    - meta_scope: comment
    - match: '%%'
      scope: constant.character.escape.spec
    - match: '%'
      scope: invalid.illegal.spec
    - match: '$'
      pop: true

  spec_section:
    - include: macro_generic

  macro_conditional:
    - match: '({{macro_cond_op}})'
      scope: keyword.operator.spec
    - match: '$'
      pop: true

  macro_define:
    - match: '{{macro_ident}}'
      scope: variable.parameter.spec
      push: macro_define_val
    - match: '$'
      pop: true

  macro_define_val:
    - match: '.*'
      scope: string.spec
    - match: '$'
      pop: true

  macro_generic:
    - match: '{{macro_param}}'
      scope: variable.parameter.spec
      pop: true
    - match: '{{macro_ident}}'
      scope: entity.spec
    - match: '[(]'
      scope: keyword.operator.spec
      set: macro_pren
    - match: '{\??'
      scope: keyword.operator.spec
      set: macro_brace
    - match: '\b'
      pop: true

  macro_brace:
    - match: '{{macro_ident}}'
      scope: entity.spec
    - match: '}'
      scope: keyword.operator.spec
      pop: true
    - match: ':'
      scope: keyword.operator.spec
      set: macro_colon

  macro_pren:
    - match: '[)]'
      scope: keyword.operator.spec
      pop: true

  macro_colon:
    - match: '%'
      scope: keyword.operator.spec
      push: macro_generic
    - match: '}'
      scope: keyword.operator.spec
      pop: true
