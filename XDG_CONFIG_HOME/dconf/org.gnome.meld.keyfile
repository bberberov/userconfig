[/]
custom-font='monospace 8'
highlight-syntax=true
indent-width=4
text-filters=[('CVS/SVN Keywords', false, '\\$\\w+(:[^\\n$]+)?\\$'), ('Leading Whitespace', false, '^[ \\t\\r\\f\\v]*'), ('Trailing Whitespace', false, '[ \\t\\r\\f\\v]*$'), ('All Whitespace', false, '[ \\t\\r\\f\\v]*'), ('C Comment', false, '/\\*.*?\\*/'), ('C++ Comment', false, '//.*'), ('Script Comment', false, '#.*'), ('Comparable comments', false, '(^\\s*(<!--|#)\\s*)|(\\s*-->\\s*$)'), ('Single/Double Quotes', false, "[\"']"), ('RPM dependencies', false, '^(# )?(Build)?(Requires:\\s+)')]
use-system-font=false
vc-left-is-local=true
vc-merge-file-order='local-merge-remote'
wrap-mode='none'

[window-state]
height=720
is-maximized=true
width=1280
