[alias]
	# Git's original blame, diff, reflog and show
	# BUG: https://github.com/dandavison/delta/issues/522
	blame-git = blame

	diff-git        = diff
	diff-git-work   = diff --patch
	diff-git-cached = diff --cached
	diff-git-merge  = diff --merge-base HEAD
	diff-git-staged = diff --staged

	rlog-git = reflog --pretty=hone --patch
	show-git = show   --pretty=hone --patch

	# diff -y equivalent, with smaller tabs
	diffy        = diff
	diffy-work   = diff --patch
	diffy-cached = diff --cached
	diffy-merge  = diff --merge-base HEAD
	diffy-staged = diff --staged

	logdiffy    = log    --pretty=hone --patch
	reflogdiffy = reflog --pretty=hone --patch
	showdiffy   = show   --pretty=hone --patch

# Requirements for blame on delta
[blame]
	coloring = none
	date = iso

[delta]
	map-styles = brightmagenta => syntax "#2f002f", brightcyan => syntax "#002f2f"

[delta "blame"]
	blame-format  = "{timestamp:<13.12} {author:<15.14} {commit:<8}"
	blame-palette = "#1f1f1f #2F0000 #002F00 #00002F #2F2F00 #2F002F #002F2F"
	tabs = 0

[delta "diff"]
	line-numbers = true
	side-by-side = false
	tabs = 4

	file-decoration-style = omit
	file-style = white blue

	file-added-label    = "    Added: "
	file-copied-label   = "   Copied: "
	file-modified-label = " Modified: "
	file-removed-label  = "  Removed: "
	file-renamed-label  = "  Renamed: "

	hunk-header-style = omit

[delta "diffy"]
	line-numbers = true
	side-by-side = true
	tabs = 4

	file-decoration-style = omit
	file-style = white blue

	file-added-label    = "    Added: "
	file-copied-label   = "   Copied: "
	file-modified-label = " Modified: "
	file-removed-label  = "  Removed: "
	file-renamed-label  = "  Renamed: "

	hunk-header-style = omit

[diff]
	colorMoved = zebra

[interactive]
	diffFilter = delta --color-only

[pager]
	blame     = LESS=\"${LESS} -cS\" delta --paging=always --features=blame

	# Git's original blame, BUG: https://github.com/dandavison/delta/issues/522
	blame-git = LESS=\"${LESS} -cS\" \"$(git var GIT_PAGER)\"

	diff        = LESS=\"${LESS} -FS\" delta --paging=auto   --features=diff
	diff-work   = LESS=\"${LESS} -cS\" delta --paging=always --features=diff
	diff-cached = LESS=\"${LESS} -cS\" delta --paging=always --features=diff
	diff-merge  = LESS=\"${LESS} -cS\" delta --paging=always --features=diff
	diff-staged = LESS=\"${LESS} -cS\" delta --paging=always --features=diff

	# Git's original diff, BUG: https://github.com/dandavison/delta/issues/522
	diff-git        = LESS=\"${LESS} -FS\" \"$(git var GIT_PAGER)\"
	diff-git-work   = LESS=\"${LESS} -cS\" \"$(git var GIT_PAGER)\"
	diff-git-cached = LESS=\"${LESS} -cS\" \"$(git var GIT_PAGER)\"
	diff-git-merge  = LESS=\"${LESS} -cS\" \"$(git var GIT_PAGER)\"
	diff-git-staged = LESS=\"${LESS} -cS\" \"$(git var GIT_PAGER)\"

	diffy        = LESS=\"${LESS} -c\" delta --paging=auto   --features=diffy
	diffy-work   = LESS=\"${LESS} -c\" delta --paging=always --features=diffy
	diffy-cached = LESS=\"${LESS} -c\" delta --paging=always --features=diffy
	diffy-merge  = LESS=\"${LESS} -c\" delta --paging=always --features=diffy
	diffy-staged = LESS=\"${LESS} -c\" delta --paging=always --features=diffy

	log       = LESS=\"${LESS} -FS\" delta --paging=auto   --features=diff
	logdiff   = LESS=\"${LESS} -c\"  delta --paging=always --features=diff
	rlog      = LESS=\"${LESS} -FS\" delta --paging=auto   --features=diff
	rlogdiff  = LESS=\"${LESS} -c\"  delta --paging=always --features=diff
	show      = LESS=\"${LESS} -FS\" delta --paging=auto   --features=diff
	showdiff  = LESS=\"${LESS} -c\"  delta --paging=always --features=diff

	# Git's original reflog, show, BUG: https://github.com/dandavison/delta/issues/522
	rlog-git = LESS=\"${LESS} -FS\" \"$(git var GIT_PAGER)\"
	show-git = LESS=\"${LESS} -FS\" \"$(git var GIT_PAGER)\"

	logdiffy  = LESS=\"${LESS} -c\"  delta --paging=always --features=diffy
	rlogdiffy = LESS=\"${LESS} -c\"  delta --paging=always --features=diffy
	showdiffy = LESS=\"${LESS} -c\"  delta --paging=always --features=diffy
